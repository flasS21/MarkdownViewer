<Window x:Class="MarkdownViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MarkdownViewer"
        Title="Markdown Viewer"
        Height="800" Width="1100"
        MinHeight="400" MinWidth="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Background}"
        Foreground="{DynamicResource Brush.TextPrimary}"
        FontFamily="{DynamicResource AppFontFamily}"
        FontSize="13"
        Closing="MainWindow_Closing"
        SourceInitialized="MainWindow_SourceInitialized"
        StateChanged="MainWindow_StateChanged"
        KeyDown="MainWindow_KeyDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40"
                      CornerRadius="8"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False"
                      ResizeBorderThickness="6" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <Border Grid.Row="0"
                Background="{DynamicResource Brush.Surface}"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- App Icon / Label -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="12,0,0,0">
                    <TextBlock Text="📄" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="Markdown Viewer"
                               FontWeight="SemiBold"
                               FontSize="13"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.TextPrimary}" />
                </StackPanel>

                <!-- Active File Name Display -->
                <TextBlock Grid.Column="1"
                           x:Name="ActiveFileText"
                           Text=""
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource Brush.TextSecondary}"
                           FontSize="12"
                           TextTrimming="CharacterEllipsis" />

                <!-- Settings Button (sliders icon) -->
                <Button Grid.Column="2"
                        x:Name="SettingsButton"
                        Style="{DynamicResource TitleBarButtonStyle}"
                        Click="SettingsButton_Click"
                        ToolTip="Settings (Ctrl+Comma)"
                        AutomationProperties.Name="Settings"
                        Margin="4,0,2,0"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                    <Path Style="{StaticResource TitleBarIcon}"
                          Data="M4 21v-7 M4 10V3 M12 21v-9 M12 8V3 M20 21v-5 M20 12V3 M3 14h6 M11 8h6 M19 16h6" />
                </Button>

                <!-- Theme Toggle (sun/moon icon) -->
                <Button Grid.Column="3"
                        x:Name="ThemeToggleButton"
                        Style="{DynamicResource TitleBarButtonStyle}"
                        Click="ThemeToggleButton_Click"
                        ToolTip="Toggle theme (Ctrl+T)"
                        AutomationProperties.Name="Toggle theme"
                        Margin="2,0,2,0"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                    <Grid Width="16" Height="16">
                        <Path x:Name="MoonPath"
                              Style="{StaticResource TitleBarIcon}"
                              Data="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
                        <Path x:Name="SunPath"
                              Style="{StaticResource TitleBarIcon}"
                              Data="M12 3v2 M12 19v2 M5 5l1.4 1.4 M19 19l1.4 1.4 M3 12h2 M19 12h2 M5 19l1.4-1.4 M19 5l1.4-1.4"
                              Visibility="Collapsed" />
                    </Grid>
                </Button>

                <!-- Open Button (folder icon + label) -->
                <Button Grid.Column="4"
                        Style="{DynamicResource TitleBarButtonStyle}"
                        Click="OpenButton_Click"
                        ToolTip="Open file in new tab (Ctrl+O)"
                        AutomationProperties.Name="Open file"
                        Margin="2,0,2,0"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource TitleBarIcon}"
                              Data="M21 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h8a2 2 0 0 1 2 2z"
                              Margin="0,0,6,0" />
                        <TextBlock Text="Open" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Close Tab Button (X icon + label) -->
                <Button Grid.Column="5"
                        Style="{DynamicResource TitleBarCloseButtonStyle}"
                        Click="CloseTabButton_Click"
                        ToolTip="Close current tab (Ctrl+W)"
                        AutomationProperties.Name="Close tab"
                        Margin="2,0,12,0"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource TitleBarIcon}"
                              Data="M21 3L3 21 M3 3l18 18"
                              Margin="0,0,6,0" />
                        <TextBlock Text="Close" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Tab Control -->
        <Grid Grid.Row="1" x:Name="TabArea">
            <TabControl x:Name="MainTabControl"
                        Background="{DynamicResource Brush.Background}"
                        BorderThickness="0"
                        Padding="0"
                        SelectionChanged="MainTabControl_SelectionChanged"
                        PreviewMouseWheel="MainTabControl_PreviewMouseWheel">
            </TabControl>

            <!-- Empty state when no tabs -->
            <Grid x:Name="EmptyState" Background="{DynamicResource Brush.Background}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Path Width="56" Height="56"
                          Stretch="Uniform"
                          Stroke="{DynamicResource Brush.Accent}"
                          StrokeThickness="1.5"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          Data="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z M14 2v6h6 M16 13H8 M16 17H8 M10 9H8"
                          Opacity="0.9"
                          HorizontalAlignment="Center"
                          Margin="0,0,0,20" />
                    <TextBlock Text="Open a .md file to get started"
                               FontSize="18"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource Brush.TextPrimary}" />
                    <TextBlock Text="Each file opens in its own tab"
                               FontSize="13"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,0"
                               Foreground="{DynamicResource Brush.TextSecondary}" />
                    <TextBlock Text="Ctrl+O  Open in new tab    •    Ctrl+W  Close tab    •    Ctrl+Tab  Switch tab"
                               FontSize="11"
                               HorizontalAlignment="Center"
                               Margin="0,16,0,0"
                               Foreground="{DynamicResource Brush.TextSecondary}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
