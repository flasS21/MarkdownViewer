<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>MarkdownViewer</RootNamespace>
    <AssemblyName>MarkdownViewer</AssemblyName>
<PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Version>0.1.0</Version>
    <Authors>MarkdownViewer</Authors>
    <Description>Standalone lightweight Markdown viewer for Windows 11</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="0.37.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2739.15" />
  </ItemGroup>

  <!-- Bundle Prism assets as embedded resources for offline use -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\prism.css">
      <LogicalName>MarkdownViewer.Assets.prism.css</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Assets\prism.js">
      <LogicalName>MarkdownViewer.Assets.prism.js</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
