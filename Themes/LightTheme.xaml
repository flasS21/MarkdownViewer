<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Controls.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- ============================================================
         LIGHT THEME — Catppuccin Latte
         Same single accent hue as the dark theme: Catppuccin Blue
         (#1e66f5 in Latte, theme-adapted shade of the identical hue
         family to maintain WCAG AA contrast on light surfaces).
         All controls reference these brushes via DynamicResource;
         no hardcoded colors exist in any view or template.
         ============================================================ -->

    <!-- Surfaces -->
    <SolidColorBrush x:Key="Brush.Background"   Color="#eff1f5" /> <!-- base     -->
    <SolidColorBrush x:Key="Brush.Surface"      Color="#e6e9ef" /> <!-- mantle   -->
    <SolidColorBrush x:Key="Brush.SurfaceAlt"   Color="#ccd0da" /> <!-- surface0 -->
    <SolidColorBrush x:Key="Brush.SurfaceHover" Color="#bcc0cc" /> <!-- surface1 -->
    <SolidColorBrush x:Key="Brush.SurfacePressed" Color="#acb0be" /> <!-- surface2 -->
    <SolidColorBrush x:Key="Brush.Border"       Color="#ccd0da" /> <!-- surface0 -->
    <SolidColorBrush x:Key="Brush.InputBackground" Color="#dce0e8" /> <!-- crust -->

    <!-- Text -->
    <SolidColorBrush x:Key="Brush.TextPrimary"   Color="#4c4f69" /> <!-- text     -->
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#5c5f77" /> <!-- subtext1 (AA-safe on base) -->
    <SolidColorBrush x:Key="Brush.TextFaint"     Color="#8c8fa1" /> <!-- overlay0 -->

    <!-- Accent (Catppuccin Blue) -->
    <SolidColorBrush x:Key="Brush.Accent"      Color="#1e66f5" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#175ad8" />
    <SolidColorBrush x:Key="Brush.TextOnAccent" Color="#ffffff" />

    <!-- Semantic -->
    <SolidColorBrush x:Key="Brush.Warning"     Color="#d20f39" /> <!-- red   -->
    <SolidColorBrush x:Key="Brush.Danger"      Color="#d20f39" /> <!-- red   -->
    <SolidColorBrush x:Key="Brush.DangerHover" Color="#b01230" />
    <SolidColorBrush x:Key="Brush.TextOnDanger" Color="#ffffff" />

    <!-- Shared effects -->
    <DropShadowEffect x:Key="DropShadowEffect"
                      BlurRadius="12"
                      ShadowDepth="2"
                      Opacity="0.16"
                      Color="#1e1e2e" />

</ResourceDictionary>
