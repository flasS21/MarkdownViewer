<Window x:Class="MarkdownViewer.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Height="740" Width="500"
        MinHeight="480" MinWidth="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Background}"
        Foreground="{DynamicResource Brush.TextPrimary}"
        FontFamily="{DynamicResource AppFontFamily}"
        FontSize="13"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="ToolWindow">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32"
                      CornerRadius="8"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <!-- Layout decision: the four option groups live inside a ScrollViewer so
         content can never be clipped, while OK/Cancel stay in a pinned footer
         that is always visible. A fixed, comfortable window height keeps the
         dialog predictable across DPI/font-size changes; the ScrollViewer only
         engages on short screens. -->
    <Grid Margin="24,16,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="⚙ Settings"
                   FontSize="20" FontWeight="SemiBold"
                   Margin="0,0,0,16" />

        <!-- Scrollable content: all four groups -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <!-- Theme Section -->
                <Border Style="{DynamicResource SettingsSectionStyle}" Margin="0,0,0,10">
                    <StackPanel Margin="16">
                        <TextBlock Text="Theme" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10" />
                        <RadioButton x:Name="FollowSystemRadio" Content="Follow Windows system theme"
                                     Margin="0,5" Checked="ThemeRadio_Checked" />
                        <RadioButton x:Name="DarkRadio" Content="Dark mode"
                                     Margin="0,5" Checked="ThemeRadio_Checked" />
                        <RadioButton x:Name="LightRadio" Content="Light mode"
                                     Margin="0,5" Checked="ThemeRadio_Checked" />
                    </StackPanel>
                </Border>

                <!-- App Font Section (WPF chrome — title bar, tabs, buttons, labels) -->
                <Border Style="{DynamicResource SettingsSectionStyle}" Margin="0,0,0,10">
                    <StackPanel Margin="16">
                        <TextBlock Text="App Font" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10" />
                        <TextBlock Text="UI chrome: title bar, tabs, buttons, labels"
                                   FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}"
                                   Margin="0,0,0,10" />
                        <ComboBox x:Name="AppFontCombo"
                                  Margin="0,0,0,10"
                                  SelectionChanged="AppFont_Changed" />
                        <TextBlock x:Name="AppFontPreview"
                                   Text="The quick brown fox jumps over the lazy dog — 0123456789"
                                   FontSize="14"
                                   Foreground="{DynamicResource Brush.TextSecondary}" />
                    </StackPanel>
                </Border>

                <!-- Body Font Section (rendered markdown prose — WebView2 only) -->
                <Border Style="{DynamicResource SettingsSectionStyle}" Margin="0,0,0,10">
                    <StackPanel Margin="16">
                        <TextBlock Text="Body Font" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10" />
                        <TextBlock Text="Markdown prose in the rendered document"
                                   FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}"
                                   Margin="0,0,0,10" />
                        <ComboBox x:Name="BodyFontCombo"
                                  Margin="0,0,0,10"
                                  SelectionChanged="BodyFont_Changed" />
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Size:" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <Slider x:Name="BodySizeSlider"
                                    Minimum="10" Maximum="24" TickFrequency="1"
                                    Width="200" VerticalAlignment="Center"
                                    ValueChanged="BodySize_Changed"
                                    IsSnapToTickEnabled="True" />
                            <TextBlock x:Name="BodySizeLabel" Text="15"
                                       VerticalAlignment="Center" Margin="10,0,0,0"
                                       Width="24" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Code Font Section (code blocks — WebView2 only) -->
                <Border Style="{DynamicResource SettingsSectionStyle}" Margin="0,0,0,10">
                    <StackPanel Margin="16">
                        <TextBlock Text="Code Font" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10" />
                        <TextBlock Text="Code blocks in the rendered document"
                                   FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}"
                                   Margin="0,0,0,10" />
                        <ComboBox x:Name="CodeFontCombo"
                                  Margin="0,0,0,10"
                                  SelectionChanged="CodeFont_Changed" />
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Size:" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <Slider x:Name="CodeSizeSlider"
                                    Minimum="9" Maximum="20" TickFrequency="0.5"
                                    Width="200" VerticalAlignment="Center"
                                    ValueChanged="CodeSize_Changed"
                                    IsSnapToTickEnabled="True" />
                            <TextBlock x:Name="CodeSizeLabel" Text="13.5"
                                       VerticalAlignment="Center" Margin="10,0,0,0"
                                       Width="30" />
                        </StackPanel>
                        <TextBlock x:Name="CodeFontWarning"
                                   Text="⚠ Selected font may not be monospace"
                                   Foreground="{DynamicResource Brush.Warning}"
                                   FontSize="11"
                                   Margin="0,8,0,0"
                                   Visibility="Collapsed" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer — always visible, never pushed off-screen -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="OK" Width="80" Height="32"
                    Click="OkButton_Click"
                    Style="{DynamicResource AccentButtonStyle}" />
            <Button Content="Cancel" Width="80" Height="32" Margin="8,0,0,0"
                    Click="CancelButton_Click"
                    Style="{DynamicResource NormalButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
